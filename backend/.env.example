# Provider: openai | doubao | glm | gemini | custom
MODEL_PROVIDER=openai

# OpenAI-compatible settings. Leave API key empty to use deterministic fallback generation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://your-doubao-or-company-gateway/v1
DOUBAO_MODEL=doubao-seed-1-6

GLM_API_KEY=
GLM_BASE_URL=https://your-glm-or-company-gateway/v1
GLM_MODEL=glm-4-plus

GEMINI_API_KEY=
GEMINI_BASE_URL=https://your-gemini-compatible-gateway/v1
GEMINI_MODEL=gemini-2.0-flash

CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://your-company-gateway/v1
CUSTOM_MODEL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_TEMPERATURE=0.35
LLM_TIMEOUT_SECONDS=45
